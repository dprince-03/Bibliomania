FROM --platform=linux/amd64 golang:1.25.5-alpine AS builder

# Install system dependencies
RUN apk add --no-cache \
    git \
    curl \
    make \
    gcc \
    musl-dev

# Install Air (hot reload). Pinned, not @latest — air v1.67.0+ requires
# Go >= 1.26, newer than this image's 1.25.5, so @latest breaks the build
# the moment air cuts a release requiring a toolchain we don't have yet.
# v1.66.1 is the newest release that still supports Go 1.25.
RUN go install github.com/air-verse/air@v1.66.1

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum first (layer caching)
COPY go.mod go.sum ./
RUN go mod tidy

# Copy air configuration
COPY .air.toml ./

# Copy the rest of the source code
COPY . .

# Expose the application port
EXPOSE 8080

# Run Air for hot reload
CMD ["air", "-c", ".air.toml"]