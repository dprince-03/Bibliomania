# Stage 1: Build
FROM node:26-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# public/ is optional in Next.js and git doesn't track empty directories —
# if it has no committed files, a fresh checkout never creates it at all,
# and the final stage's COPY --from=builder below would fail with
# "not found". Guarantee it exists regardless of what's actually in it.
RUN mkdir -p public

# next.config.mjs sets output: "standalone"
RUN npm run build

# Stage 2: Minimal runtime — only the traced files next build copied into .next/standalone
FROM node:26-alpine AS final

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

USER appuser

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
