# Stage 1: Build the static export
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# NEXT_PUBLIC_* vars are inlined into the static export at build time — the
# final stage has no Node runtime to read them from, so they must arrive as
# build args (see docker-compose.prod.yml), not container `environment:`.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

# next.config.mjs sets output: "export" — `next build` produces ./out
RUN npm run build

# Stage 2: Serve the static output — no Node runtime needed
# nginx-unprivileged (official, from NGINX Inc.): runs as uid 101 instead of
# root, so it listens on 8080 (non-root can't bind ports below 1024) and keeps
# its pid/temp files in /tmp — works with a read-only root filesystem.
FROM nginxinc/nginx-unprivileged:alpine AS final

COPY --from=builder /app/out /usr/share/nginx/html

# The base image already runs as 101 (nginx); stated explicitly, and
# numerically so Kubernetes' runAsNonRoot can verify it.
USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/ || exit 1
