# Stage 1: Build the static export
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# NEXT_PUBLIC_* vars are inlined into the static export at build time — the
# final stage has no Node runtime to read them from, so they must arrive as
# build args (see docker-compose.prod.yml), not container `environment:`.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

# next.config.mjs sets output: "export" — `next build` produces ./out
RUN npm run build

# Stage 2: Serve the static output — no Node runtime needed
FROM nginx:alpine AS final

COPY --from=builder /app/out /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1
