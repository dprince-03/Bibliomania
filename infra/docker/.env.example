# Compose-level environment for the infra stack (infra/docker/).
# Copy to .env at the repo root and run `docker compose` from the repo root
# with `--env-file .env` — see infra/README.md for the exact commands
# (NOT --project-directory ., which breaks how the compose files' relative
# paths resolve).
#
# This is separate from Server/app/.env(.example), which holds the Go
# services' shared app-level config (JWT secret, timeouts, etc.) — every
# Go service container loads it, with the connection settings below
# layered on top by docker-compose.yml.

# ── Databases — one per service (see Server/app/docs/plan.md) ───────
# auth-service → MySQL. docker-compose.yml builds auth's DATABASE_URL from
# these AND passes them to the `mysql` container's init, so the two can't
# drift apart.
AUTH_DB_NAME=bibliomania_auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=changeme
AUTH_DB_ROOT_PASSWORD=changeme

# catalog / borrow / user / payment → one Postgres server, one database and
# one role per service (created by postgres/init/*.sql on first
# boot — changing a password later means ALTER ROLE, not just this file).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
CATALOG_DB_PASSWORD=changeme
BORROW_DB_PASSWORD=changeme
USER_DB_PASSWORD=changeme
PAYMENT_DB_PASSWORD=changeme

# reading-service → MongoDB (no credentials yet — known gap, see
# docker-compose.prod.yml's mongo note).

# ── Redis (catalog-service's cache) ───────────────────────
REDIS_PASSWORD=

# ── Object storage (SeaweedFS S3 API — e-library files) ───
# auth ↔ user reconciler (auth's /internal/v1/accounts). Change outside dev.
INTERNAL_API_TOKEN=dev-internal-token-change-me
S3_ACCESS_KEY=bibliomania
S3_SECRET_KEY=changeme-s3
# Virus-scan uploads: start ClamAV with `--profile scan` and set
# CLAMAV_ADDR=clamav:3310. Empty = no scanning.
CLAMAV_ADDR=

# ── Message brokers ───────────────────────────────────────
# RabbitMQ (auth/user/catalog events). Kafka and NATS run without auth
# inside the network.
RABBITMQ_USER=bibliomania
RABBITMQ_PASSWORD=changeme

# ── Gateway ───────────────────────────────────────────────
# REST API versions to announce as deprecated, as
# "version:deprecatedOn[:sunsetOn]" (dates YYYY-MM-DD), comma-separated —
# e.g. v1:2027-01-01:2027-07-01. Empty = nothing deprecated.
API_DEPRECATED_VERSIONS=

# ── Payments (payment-service: Stripe + Paystack) ─────────
# The book's currency picks the provider: PAYSTACK_CURRENCIES go to
# Paystack, everything else to Stripe (a checkout can also name one).
# A provider with no secret key is simply disabled (its checkouts → 503).
# Test keys only until Step 38's penetration test passes: any sk_live_ key
# (both providers use that prefix) makes payment-service refuse to start
# unless PAYMENTS_LIVE_ENABLED=true.
# Webhook URLs to register: /api/v1/payments/webhook/stripe and
# /api/v1/payments/webhook/paystack (Paystack signs with the secret key —
# there's no separate webhook secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=NGN,GHS,ZAR,KES
PAYMENTS_LIVE_ENABLED=false

# ── Observability ─────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── Umami analytics — its OWN Postgres, distinct from the DB_* MySQL above.
# Never point these at the app's MySQL instance.
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=changeme
UMAMI_POSTGRES_DB=umami
# Generate with: openssl rand -hex 32
UMAMI_APP_SECRET=changeme

# ── Frontend → API URLs (baked in at container start via env, not build) ──
WEB_APP_API_URL=http://api.bibliomania.local
ADMIN_WEB_API_URL=http://admin.bibliomania.local/api

# ── Email (notification-service) ─────────────────────────
# Prod: RESEND_API_KEY (Resend's HTTP API). Dev: docker-compose.dev.yml
# points notification-service at the mailpit container instead.
RESEND_API_KEY=
MAIL_FROM=Bibliomania <no-reply@bibliomania.local>

# ── Dev host ports (docker-compose.dev.yml only) ─────────
# This machine runs several other projects' Docker stacks with their own
# host-port claims. These defaults were checked against `docker ps` and are
# free as of the last check — if a future project collides with one of
# these, override it here rather than editing docker-compose.dev.yml.
# (Internal container-to-container ports are unaffected by any of this.)
NGINX_HOST_PORT=9080
# SERVER_HOST_PORT is the gateway (it took over the old monolith `app`).
SERVER_HOST_PORT=9081
WEB_MAIN_HOST_PORT=9082
WEB_APP_HOST_PORT=9083
ADMIN_WEB_HOST_PORT=9084
ADMIN_API_HOST_PORT=9085
DB_PORT=9086
REDIS_PORT=9087
ADMINER_HOST_PORT=9088
MAILPIT_WEB_PORT=9089
MAILPIT_SMTP_PORT=9090
POSTGRES_HOST_PORT=9091
MONGO_HOST_PORT=9092
RABBITMQ_UI_HOST_PORT=9093
NATS_MONITOR_HOST_PORT=9094
GRAFANA_HOST_PORT=9095
PROMETHEUS_HOST_PORT=9096
S3_HOST_PORT=9099
ALERTMANAGER_HOST_PORT=9101
