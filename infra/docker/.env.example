# Compose-level environment for the infra stack (infra/docker/).
# Copy to .env at the repo root and run `docker compose` from the repo root
# with `--env-file .env` — see infra/README.md for the exact commands
# (NOT --project-directory ., which breaks how the compose files' relative
# paths resolve).
#
# This is separate from Server/.env(.example), which holds the Go API's own
# app-level config (JWT secret, per-service timeouts, etc).

# ── App database (MySQL) ─────────────────────────────────
# These values are the source of truth for both the `mysql` container's init
# env AND the `server` container's DB connection — docker-compose.yml
# overrides Server/.env's DB_* keys with these at container start, so the two
# can never drift out of sync. (Server/.env's own DB_* values still matter
# when running the API outside Docker.)
DB_NAME=bibliomania
DB_USER=bibliomania
DB_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Go API ────────────────────────────────────────────────
# This is the container's INTERNAL listen port (also what nginx proxies to)
# — not the host-published port. See "Dev host ports" below for that.
SERVER_PORT=8080

# ── Umami analytics — its OWN Postgres, distinct from the DB_* MySQL above.
# Never point these at the app's MySQL instance.
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=changeme
UMAMI_POSTGRES_DB=umami
# Generate with: openssl rand -hex 32
UMAMI_APP_SECRET=changeme

# ── Frontend → API URLs (baked in at container start via env, not build) ──
WEB_APP_API_URL=http://api.bibliomania.local
ADMIN_WEB_API_URL=http://admin.bibliomania.local/api

# ── Production email (Resend) ────────────────────────────
# Not yet consumed by any app code — reserved for when a mailer is added.
# Dev email instead goes through the mailpit container (SMTP_HOST=mailpit).
RESEND_API_KEY=

# ── Dev host ports (docker-compose.dev.yml only) ─────────
# This machine runs several other projects' Docker stacks with their own
# host-port claims. These defaults were checked against `docker ps` and are
# free as of the last check — if a future project collides with one of
# these, override it here rather than editing docker-compose.dev.yml.
# (Internal container-to-container ports are unaffected by any of this.)
NGINX_HOST_PORT=9080
SERVER_HOST_PORT=9081
WEB_MAIN_HOST_PORT=9082
WEB_APP_HOST_PORT=9083
ADMIN_WEB_HOST_PORT=9084
ADMIN_API_HOST_PORT=9085
DB_PORT=9086
REDIS_PORT=9087
ADMINER_HOST_PORT=9088
MAILPIT_WEB_PORT=9089
MAILPIT_SMTP_PORT=9090
