# Copied to secrets.env (git-ignored) by `make -C infra/k8s secrets`, which
# also replaces JWT_SECRET and INTERNAL_API_TOKEN with random values. Dev values only.
JWT_SECRET=replace-me
INTERNAL_API_TOKEN=replace-me
AUTH_DB_PASSWORD=changeme
AUTH_DB_ROOT_PASSWORD=changeme
POSTGRES_PASSWORD=changeme
CATALOG_DB_PASSWORD=changeme
BORROW_DB_PASSWORD=changeme
USER_DB_PASSWORD=changeme
PAYMENT_DB_PASSWORD=changeme
RABBITMQ_PASSWORD=changeme
MYSQL_REPLICATION_PASSWORD=changeme-repl
REDIS_PASSWORD=
S3_ACCESS_KEY=bibliomania
S3_SECRET_KEY=changeme-s3
GRAFANA_ADMIN_PASSWORD=changeme
UMAMI_POSTGRES_PASSWORD=changeme
UMAMI_APP_SECRET=changeme
# Payment/email providers — empty disables them (test keys only; a
# sk_live_ key needs PAYMENTS_LIVE_ENABLED=true, see Step 38).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
