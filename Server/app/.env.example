# Shared config for every Go service in Server/app (loaded from this file
# by `go run`, and by each service container via docker-compose's
# env_file). Connection settings for each service's own database/broker
# are set per container in infra/docker/docker-compose.yml — the values
# below are for running a service directly on the host (`make run
# SERVICE=...`) against the dev stack's published ports.

# Server
APP_ENV=development
SERVER_PORT=8080
GRPC_PORT=9090
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10

# JWT — the SAME secret for every service: each verifies tokens itself.
# Generate with: go run ./cmd/key
JWT_SECRET=your-secret-here
# auth's internal accounts endpoint + user-service's reconciler (empty = reconciler off)
INTERNAL_API_TOKEN=
RECONCILE_INTERVAL_MINUTES=60
JWT_ACCESS_TOKEN_TTL=15      # minutes
JWT_REFRESH_TOKEN_TTL=10080  # minutes (7 days)

# ── Per-service connection (host-run only; Compose sets these itself) ──
# auth → MySQL:     DATABASE_URL=auth:changeme@tcp(localhost:9086)/bibliomania_auth
# catalog → Postgres: DATABASE_URL=postgres://catalog:changeme@localhost:9091/bibliomania_catalog?sslmode=disable
# borrow → Postgres:  DATABASE_URL=postgres://borrow:changeme@localhost:9091/bibliomania_borrow?sslmode=disable
# user → Postgres:    DATABASE_URL=postgres://users:changeme@localhost:9091/bibliomania_user?sslmode=disable
# payment → Postgres: DATABASE_URL=postgres://payment:changeme@localhost:9091/bibliomania_payment?sslmode=disable
# reading → MongoDB:  MONGO_URL=mongodb://localhost:9092/?directConnection=true
DATABASE_URL=

# Redis (catalog cache)
REDIS_HOST=localhost
REDIS_PORT=9087
REDIS_PASSWORD=
REDIS_DB=0

# Storage (catalog's e-library uploads)
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# Rate limiting (gateway)
RATE_LIMIT_RPS=100       # requests per second
RATE_LIMIT_BURST=200

# Borrowing
BORROW_LOAN_DAYS=14
OVERDUE_SWEEP_INTERVAL_SECONDS=300

# Observability — OTLP/gRPC endpoint for traces (Tempo). Empty = don't export.
OTEL_EXPORTER_OTLP_ENDPOINT=
