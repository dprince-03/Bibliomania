# Server
APP_ENV=development
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=DbName

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-here
JWT_ACCESS_TOKEN_TTL=15      # minutes
JWT_REFRESH_TOKEN_TTL=10080  # minutes (7 days)

# Storage (E-Library uploads)
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_RPS=100       # requests per second
RATE_LIMIT_BURST=200

# Email — reserved, not yet consumed by any app code.
# Dev: SMTP_HOST=mailpit (see infra/docker/docker-compose.dev.yml).
# Prod: RESEND_API_KEY (transactional email via Resend's API, no SMTP).
SMTP_HOST=
SMTP_PORT=
RESEND_API_KEY=