# Server-only base URL of the Go API — used by src/lib/api.js. Never
# exposed to the browser (no NEXT_PUBLIC_ prefix).
API_INTERNAL_URL=http://localhost:8080

# Public base URL of the Go API — only needed if a page fetches from the
# browser directly (none do yet, as of Step 1).
NEXT_PUBLIC_API_URL=http://localhost:8080
