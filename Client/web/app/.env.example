# Server-only base URL of the API gateway (Server/app/cmd/gateway) — used
# by src/lib/api.js. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
# 9081 = the dev Compose stack's published gateway port (SERVER_HOST_PORT).
API_INTERNAL_URL=http://localhost:9081

# Public base URL of the gateway — only needed if a page fetches from the
# browser directly (none do yet, as of Step 1).
NEXT_PUBLIC_API_URL=http://localhost:9081
