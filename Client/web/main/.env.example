# Base URL of the Go API — used for the live book/author counts on the home page.
# In docker-compose, WEB_MAIN_API_URL overrides this at build time (prod) or runtime (dev).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Base URL of the product app — used for every "Open the App" link.
# In docker-compose, WEB_MAIN_APP_URL overrides this at build time (prod) or runtime (dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000
